# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Pterodactyl Application API (server-side only) ─────────────
PTERODACTYL_URL=          # Panel URL, e.g. https://panel.example.com
PTERODACTYL_APPLICATION_TOKEN= # Admin Application API key; never use a VITE_ prefix
PTERODACTYL_TIMEOUT_MS=12000 # Outbound request timeout (1,000–60,000 ms)

# ── Server binding ─────────────────────────────────────────────
HOST=0.0.0.0               # Interface the production server binds to
PORT=3000                  # Production server port
ALLOWED_HOSTS=             # Optional comma-separated host allowlist for the
                           # Vite dev/preview server (empty accepts any host)
